[MASTER]
# Add the src directory to the Python path
init-hook='import sys; sys.path.append("src")'

[MESSAGES CONTROL]
# Disable false positives for relative imports in src package
disable=fixme,
        broad-except,
        relative-beyond-top-level

[FORMAT]
max-line-length=120

[BASIC]
good-names=i,j,k,ex,Run,_,e,f,id

[DESIGN]
max-args=7
max-attributes=10
