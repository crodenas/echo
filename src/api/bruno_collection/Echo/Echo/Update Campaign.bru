meta {
  name: Update Campaign
  type: http
  seq: 5
}

put {
  url: {{url}}/campaigns/1
  body: json
  auth: inherit
}

body:json {
  {
    "name": "My First Campaign",
    "campaign_schedule": "cron(*/20 * * * ? *)",
    "cycle_schedule": "cron(*/1 * * * ? *)",
    "description": "Campaign 1 Description",
    "max_events": 4
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
